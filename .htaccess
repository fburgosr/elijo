# Elijo: rutas de la API y del panel, cabeceras de seguridad y archivos protegidos.
RewriteEngine On
RewriteRule ^api/ api.php [L,QSA]
RewriteRule ^admin/?$ admin.html [L]

# Nada de esto debe servirse desde el sitio.
<FilesMatch "^(lib\.php|router\.php|package\.json|README\.md|\.gitignore)$">
    Require all denied
</FilesMatch>
RedirectMatch 404 ^/(herramientas|data)(/|$)
RedirectMatch 404 /\.git(/|$)

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
    Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; frame-ancestors 'none'"
    <FilesMatch "\.(js|css|svg|webmanifest|json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

AddType application/manifest+json .webmanifest
